--- !u!114 &1504234060
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1504234059}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d7aa04689ecb6924bb9848152f5e62d9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogue:
    dialogueLines:
    - character:
        name: Morvane
        icon: {fileID: 869631482, guid: d2c32b4c9c4450a49a2c520165af7918, type: 3}
      line: You received our letter.
    - character:
        name: Elien
        icon: {fileID: 1678751631, guid: b3ba63df58cd53b4e851ad22d89519dd, type: 3}
      line: You knew what happened.
    - character:
        name: Morvane
        icon: {fileID: 869631482, guid: d2c32b4c9c4450a49a2c520165af7918, type: 3}
      line: Grief is loud. We hear it.
    - character:
        name: Elien
        icon: {fileID: 1678751631, guid: b3ba63df58cd53b4e851ad22d89519dd, type: 3}
      line: You can bring them back.
    - character:
        name: Morvane
        icon: {fileID: 869631482, guid: d2c32b4c9c4450a49a2c520165af7918, type: 3}
      line: We can return what was taken.
    - character:
        name: Morvane
        icon: {fileID: 869631482, guid: d2c32b4c9c4450a49a2c520165af7918, type: 3}
      line: ..........
    - character:
        name: Elien
        icon: {fileID: 1678751631, guid: b3ba63df58cd53b4e851ad22d89519dd, type: 3}
      line: "Then why me? Why don\u2019t you take it yourselves?"
    - character:
        name: Morvane
        icon: {fileID: 869631482, guid: d2c32b4c9c4450a49a2c520165af7918, type: 3}
      line: Lumenwood forbids us.
    - character:
        name: Elien
        icon: {fileID: 1678751631, guid: b3ba63df58cd53b4e851ad22d89519dd, type: 3}
      line: The forest rejects our kind.
    - character:
        name: Morvane
        icon: {fileID: 869631482, guid: d2c32b4c9c4450a49a2c520165af7918, type: 3}
      line: It answers only to the living.
    - character:
        name: Elien
        icon: {fileID: 1678751631, guid: b3ba63df58cd53b4e851ad22d89519dd, type: 3}
      line: And if I refuse?
    - character:
        name: Morvane
        icon: {fileID: 869631482, guid: d2c32b4c9c4450a49a2c520165af7918, type: 3}
      line: Then they remain as they are.
  triggerOnEnter: 0
  interactAction: {fileID: 1781555164194001046, guid: acbbc5e977485b3409ff7736e3308455, type: 3}
