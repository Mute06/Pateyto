--- !u!114 &875055176
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 875055170}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a406dc2904c642c44a21fc474a2d6610, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: BERAY
        icon: {fileID: -1457960772, guid: bfa0b4df3317e704ab9f632fce4d9c5a, type: 3}
      line: "Buras\u0131 karanl\u0131k ve zorlu bir labirente benziyor."
    - character:
        name: BERAY
        icon: {fileID: -1457960772, guid: bfa0b4df3317e704ab9f632fce4d9c5a, type: 3}
      line: "\u0130\u015Fte efsanevi mor converselerin daha h\u0131zl\u0131 y\xFCr\xFCmeni
        sa\u011Flayacaklar."
    - character:
        name: "S\xDCM"
        icon: {fileID: -705468327, guid: 5eacec9bcf4563a44ab75756e13457b6, type: 3}
      line: "Ya BERAY neden bana bu ayakkab\u0131lar\u0131 daha \xF6nce vermedin?
        Hayaletlerden ka\xE7arken \xE7ok i\u015Fime yarayabilirdi!"
    - character:
        name: BEREAY
        icon: {fileID: -1457960772, guid: bfa0b4df3317e704ab9f632fce4d9c5a, type: 3}
      line: "\xD6z\xFCr dilerim S\xFCm. E\u011Flenceyi mahvetmek istemedim :)"
    - character:
        name: "S\xDCM"
        icon: {fileID: -705468327, guid: 5eacec9bcf4563a44ab75756e13457b6, type: 3}
      line: "NEYSE yine de te\u015Fekk\xFCrler Barray! Daha \xF6nce hi\xE7 bu kadar
        h\u0131zl\u0131 hissetmemi\u015Ftim! HAD\u0130 HAD\u0130 HAD\u0130!"
  triggerOnEnter: 0
