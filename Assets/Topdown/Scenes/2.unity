  m_Script: {fileID: 11500000, guid: a406dc2904c642c44a21fc474a2d6610, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: "S\xDCM"
        icon: {fileID: -705468327, guid: 5eacec9bcf4563a44ab75756e13457b6, type: 3}
      line: "Sonunda... ba\u015Fard\u0131m. Ama... herkes nerede?"
    - character:
        name: "S\xDCM"
        icon: {fileID: -705468327, guid: 5eacec9bcf4563a44ab75756e13457b6, type: 3}
      line: "Beray! Bu bir \u015Fakaysa hi\xE7 komik de\u011Fil!"
    - character:
        name: "S\xDCM"
        icon: {fileID: -705468327, guid: 5eacec9bcf4563a44ab75756e13457b6, type: 3}
      line: "Ciddiyim Beray, ortaya \xE7\u0131ksana! Biraz korkmaya ba\u015Flad\u0131m..."
    - character:
        name: BERAY
        icon: {fileID: -1457960772, guid: bfa0b4df3317e704ab9f632fce4d9c5a, type: 3}
      line: "S\xFCrpriz!!! Do\u011Fum g\xFCn\xFCn kutlu olsun S\xFCm! B\xFCt\xFCn
        bu macera, senin i\xE7in haz\u0131rlad\u0131\u011F\u0131m\u0131z s\xFCrpriz
        partiye ula\u015Fman i\xE7indi!"
  triggerOnEnter: 1
